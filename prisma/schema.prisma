generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  REFEREE
}

enum MatchStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum MatchOfficialRole {
  REFEREE
  ASSISTANT_REFEREE_1
  ASSISTANT_REFEREE_2
  FOURTH_OFFICIAL
  VAR
  AVAR
}

model User {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  password String
  role     Role    @default(REFEREE)
  assignments MatchAssignment[]
}

model Match {
  id           Int               @id @default(autoincrement())
  homeTeam     String
  awayTeam     String
  date         DateTime
  competition  String?
  venue        String?
  status       MatchStatus       @default(SCHEDULED)
  assignments  MatchAssignment[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model MatchAssignment {
  id        Int               @id @default(autoincrement())
  matchId   Int
  refereeId Int
  role      MatchOfficialRole
  match     Match             @relation(fields: [matchId], references: [id], onDelete: Cascade)
  referee   User              @relation(fields: [refereeId], references: [id], onDelete: Restrict)

  @@unique([matchId, role])
  @@unique([matchId, refereeId])
  @@index([refereeId])
}